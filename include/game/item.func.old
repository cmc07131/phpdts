			$dice = diceroll(100);
			//$dice = rand(1,100);
			if($dice <= 75){//一般物品
				$itemflag = $itmlow;
			}elseif($dice <= 95){//中級道具
				$itemflag = $itmmedium;
			}elseif($dice <= 97){//神裝
				$itemflag = $itmhigh;
			}elseif($dice <= 99){//禮品盒和遊戲王
				$file = config('present',$gamecfg);
