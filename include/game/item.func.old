			$flag = false;
			for($i = 1; $i <= 6; $i ++) {
				//global ${'itm' . $i}, ${'itme' . $i};
				if (${'itm' . $i} == '移動PC') {
					${'itme' . $i} += $itme;
					$itms --;
					$flag = true;
