  "questions": {
    "cord_prolapse": [
      {
        "id": "cp1",
        "stem": "After ROM you see/feel cord and FHR is 90. Best immediate maternal position?",
        "options": [
          "Lithotomy head-up",
          "Knee–chest or Sims / head-down",
          "Sitting upright",
          "Standing"
        ],
        "correct": 1,
        "rationale": "Knee–chest or Sims/head-down reduces compression pending Cat-1 CS."
      },
      {
        "id": "cp2",
        "stem": "Regarding the prolapsed cord, which is correct?",
        "options": [
          "Vigorously replace into uterus",
          "Rub cord to raise FHR",
          "Minimal handling; moist gauze ± gentle vaginal replacement",
          "Clamp until CS"
        ],
        "correct": 2,
        "rationale": "Avoid vasospasm; gentle moist protection."
      },
      {
        "id": "cp3",
        "stem": "While awaiting Cat-1 CS, how do you offload the cord?",
        "options": [
          "Fundal pressure",
          "Manual elevation of presenting part (± bladder fill 500–700 mL)",
          "Start oxytocin",
          "Forceps in ED"
        ],
        "correct": 1,
        "rationale": "Elevate presenting part; bladder fill adjunct."
      },
      {
        "id": "cp4",
        "stem": "Risk factor for cord prolapse?",
        "options": [
          "Engaged cephalic only",
          "Footling breech / malpresentation",
          "Oligohydramnios always protective",
          "No ROM ever"
        ],
        "correct": 1,
        "rationale": "Malpresentation, prematurity, polyhydramnios, twins, ARM, long cord."
      }
    ],
